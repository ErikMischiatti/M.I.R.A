#!/usr/bin/env bash
#
# M.I.R.A. launcher.
#
# Runs the desktop application from any working directory using the
# repository's own virtual environment. Intended to be reached through a
# symlink on PATH, for example:
#
#   ln -s "$PWD/bin/mira" ~/.local/bin/MIRA
#
set -euo pipefail

# Resolve this script through any symlink chain so the repository root is
# derived from the real file location, not from the caller's PATH entry.
script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
repo_root="$(cd -- "$(dirname -- "$script_path")/.." && pwd -P)"

python_bin="$repo_root/venv/bin/python"

if [ ! -x "$python_bin" ]; then
    printf 'MIRA: no virtual environment at %s\n' "$repo_root/venv" >&2
    printf 'MIRA: create it with\n' >&2
    printf '  cd %s\n' "$repo_root" >&2
    printf '  python3.12 -m venv venv\n' >&2
    printf '  venv/bin/python -m pip install --requirement requirements.txt\n' >&2
    exit 1
fi

# Runtime resource and safety paths are resolved explicitly by the application.
# Preserve the caller's directory so the intentionally CWD-relative "current"
# desktop action reports the directory from which MIRA was invoked.

# exec so signals and the exit status pass straight through to the caller.
exec "$python_bin" -m mira.main "$@"
